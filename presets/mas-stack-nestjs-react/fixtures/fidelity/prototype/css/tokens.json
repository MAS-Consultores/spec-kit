{
  "color": {
    "brand": "#123456",
    "brandForeground": "#ffffff",
    "railEnd": "#0b1f33"
  },
  "font": {
    "family": "Fidelity Sans",
    "weight": 400,
    "size": "16px"
  },
  "radius": { "header": "8px" },
  "shadow": { "header": "0 2px 4px rgb(0 0 0 / 0.2)" },
  "space": { "headerPadding": "16px", "railWidth": "240px", "railCollapsed": "72px" },
  "breakpoint": { "mobile": "640px" },
  "motion": {
    "pulse": "brand-pulse 1.2s ease-in-out",
    "transition": "background-color 200ms ease"
  }
}
