# Copy to .env. Placeholders only. Do not put real secrets here.
# The API reads these from the process environment. Vite proxies /api to API_PROXY_TARGET.

DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/app
# Optional. Leave this blank for one local database: pnpm db:setup and pnpm db:seed
# migrate and seed DATABASE_URL when its host is 127.0.0.1, localhost, or ::1.
# Any other host is refused while this is blank. CI and e2e set a different database.
SEED_DATABASE_URL=
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
LOGIN_THROTTLE_LIMIT=1000
PORT=3001
LOG_LEVEL=info
NODE_ENV=development
API_PROXY_TARGET=http://127.0.0.1:3001

# Leave empty when the browser talks to the API through the Vite /api proxy.
# Set an explicit origin only when the browser calls the API host directly.
CORS_ORIGIN=

# Empty, false, or 0: do not trust X-Forwarded-For. loopback or a hop count only. Never true.
TRUST_PROXY=

# MCP stays in the preset and is off until a project has tools. true or 1 mounts /api/v1/mcp.
MCP_ENABLED=false
