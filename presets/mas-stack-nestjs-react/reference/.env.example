# Copy to .env. Placeholders only. Do not put real secrets here.
# The API reads these from the process environment. Vite proxies /api to API_PROXY_TARGET.

DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/app
SEED_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/e2e
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
LOGIN_THROTTLE_LIMIT=1000
PORT=3001
API_PROXY_TARGET=http://127.0.0.1:3001

# Leave empty when the browser talks to the API through the Vite /api proxy.
# Set an explicit origin only when the browser calls the API host directly.
CORS_ORIGIN=
